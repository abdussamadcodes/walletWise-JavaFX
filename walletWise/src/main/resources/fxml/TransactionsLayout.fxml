<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" style="-fx-background-color: #ecf0f1; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.walletwise.controller.TransactionsController">

    <Label text="Transaction History" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
        <!-- Row 1: Search, Type, and NEW CATEGORY FILTER -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search by ID or Description..." prefWidth="250" style="-fx-font-size: 14px; -fx-padding: 5;"/>
            <ComboBox fx:id="typeFilterCombo" prefWidth="130" style="-fx-font-size: 14px;"/>

            <!-- NEW: Dynamic Category Dropdown Filter -->
            <ComboBox fx:id="categoryFilterCombo" prefWidth="150" style="-fx-font-size: 14px;"/>

            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="recordCountLabel" text="0 records found" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
        </HBox>

        <!-- Row 2: Date Filters -->
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="From Date:" style="-fx-font-size: 14px;"/>
            <DatePicker fx:id="startDatePicker" prefWidth="140"/>

            <Label text="To Date:" style="-fx-font-size: 14px;"/>
            <DatePicker fx:id="endDatePicker" prefWidth="140"/>

            <Button text="Clear Filters" onAction="#handleClearFilters" style="-fx-background-color: #bdc3c7; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px;">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50" />
            <TableColumn fx:id="dateCol" text="Date" prefWidth="120" />
            <TableColumn fx:id="typeCol" text="Type" prefWidth="100" />
            <TableColumn fx:id="categoryCol" text="Category" prefWidth="150" />
            <TableColumn fx:id="amountCol" text="Amount" prefWidth="120" />
            <TableColumn fx:id="descCol" text="Description" prefWidth="200" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Add Transaction" onAction="#handleAdd"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="Edit Transaction" onAction="#handleEdit"
                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>
        <Button text="Delete Transaction" onAction="#handleDelete"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand;"/>

        <Label fx:id="messageLabel" style="-fx-font-size: 14px; -fx-padding: 0 0 0 20;"/>
    </HBox>
</VBox>