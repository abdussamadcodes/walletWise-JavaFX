<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.walletwise.controller.DashboardController">

    <Label text="Dashboard Overview" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <HBox spacing="20">
        <!-- Balance Card -->
        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Label text="Total Balance" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            <!-- FIX: Removed the $ symbol here -->
            <Label fx:id="balanceLabel" text="0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        </VBox>

        <!-- Income Card -->
        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Label text="Total Income" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            <!-- FIX: Removed the $ symbol here -->
            <Label fx:id="incomeLabel" text="0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </VBox>

        <!-- Expense Card -->
        <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" HBox.hgrow="ALWAYS">
            <Label text="Total Expenses" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            <!-- FIX: Removed the $ symbol here -->
            <Label fx:id="expenseLabel" text="0.00" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
        </VBox>
    </HBox>

    <VBox style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" VBox.vgrow="ALWAYS">
        <Label text="Income vs Expenses" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <PieChart fx:id="pieChart" VBox.vgrow="ALWAYS" />
    </VBox>

</VBox>