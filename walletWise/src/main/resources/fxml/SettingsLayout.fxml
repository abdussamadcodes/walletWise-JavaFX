<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.walletwise.controller.SettingsController">

    <Label text="Settings &amp; Data Management" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- EXPORT CARD -->
    <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 3);">
        <Label text="Export Transactions to JSON" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <GridPane hgap="15" vgap="12">
            <Label text="Search Text:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="searchField" promptText="ID, description..." prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Type:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="typeFilterCombo" prefWidth="160" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="categoryFilterCombo" prefWidth="250" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Date Range:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <DatePicker fx:id="startDatePicker" promptText="From" prefWidth="120"/>
                <DatePicker fx:id="endDatePicker" promptText="To" prefWidth="120"/>
            </HBox>
        </GridPane>

        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10 0 0 0;">
            <Button text="Export Filtered JSON" onAction="#handleExportJSON"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button text="Reset Filters" onAction="#handleResetFilters"
                    style="-fx-background-color: #bdc3c7; -fx-text-fill: #2c3e50; -fx-padding: 8 16; -fx-cursor: hand;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="exportPreviewLabel" text="0 records selected for export" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        </HBox>

        <Label fx:id="exportStatusLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

        <!-- FIX: Added fixedCellSize, minHeight, and prefHeight to stop bouncing -->
        <TableView fx:id="previewTable" VBox.vgrow="ALWAYS" prefHeight="250" minHeight="150" fixedCellSize="30" style="-fx-font-size: 13px;">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="50" />
                <TableColumn fx:id="dateCol" text="Date" prefWidth="100" />
                <TableColumn fx:id="typeCol" text="Type" prefWidth="90" />
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="130" />
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="100" />
                <TableColumn fx:id="descCol" text="Description" prefWidth="180" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- IMPORT CARD -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 8, 0, 0, 3);">
        <Label text="Import Transactions from JSON" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="Upload a WalletWise JSON file. Duplicates matching existing transactions will be automatically skipped." style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button text="Choose JSON File &amp; Import" onAction="#handleImportJSON"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Label fx:id="importStatusLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

</VBox>